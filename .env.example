# .env (Servidor de Producao)
# Este arquivo deve ser criado no servidor em /home/italo-server/uni-stay/.env

# Versão da imagem Docker a ser utilizada (o CI/CD atualiza automaticamente)
APP_VERSION=latest

# Nome do repositório no GitHub (ex: italoptes/uni-stay) para puxar a imagem correta
GITHUB_REPOSITORY_LOWERCASE=italoptes/uni-stay

# Credenciais e Dados do Banco (Nao alterar se o banco ja existir)
POSTGRES_DB=unistay
POSTGRES_USER=postgres
POSTGRES_PASSWORD=senha_segura_do_banco

# String de conexao do Spring com o banco (nome do servico do compose = postgres)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/unistay

# Seguranca do JWT
JWT_SECRET=chave_muito_segura_e_longa_para_producao_aqui
